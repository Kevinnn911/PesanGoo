# File: .env.example

# Supabase Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_JWKS_URL="https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json"

# Database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@your-db-host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@your-db-host:5432/postgres"

# Auth
JWT_SECRET="your_jwt_secret_key"

# App URL (update after deployment)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Socket.IO Server (Railway URL - update after deploying socket-server)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_SERVER_SECRET="your_socket_server_secret"
